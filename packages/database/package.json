{
  "name": "@riskflow/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/test-postgres.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "tsx src/seed-cli.ts",
    "ops": "tsx src/ops-cli.ts",
    "lint": "eslint .",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "test": "node scripts/generate.mjs && vitest run",
    "postinstall": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@riskflow/permissions": "workspace:*"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
