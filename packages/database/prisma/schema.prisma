generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  status    String   @default("active")
  locale       String   @default("fi")
  timezone     String   @default("Europe/Helsinki")
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships        Membership[]
  orgUnits           OrgUnit[]
  orgUnitMemberships OrgUnitMembership[]
  roles              Role[]
  rolePermissions    RolePermission[]
  membershipRoles    MembershipRole[]
  riskCategories     RiskCategory[]
  risks              Risk[]
  scoringModels      ScoringModel[]
  riskAssessments    RiskAssessment[]
  treatments         RiskTreatment[]
  actions            RiskAction[]
  approvals          Approval[]
  auditEvents        AuditEvent[]
  outboxEvents       OutboxEvent[]
  invitations        Invitation[]
  formDefinitions    FormDefinition[]
  formVersions       FormVersion[]
  entitlements       TenantEntitlement[]
  tenantModules      TenantModule[]
  attachments        Attachment[]
  notifications      Notification[]

  @@map("tenants")
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authSubject   String   @unique @map("auth_subject")
  email         String
  displayName   String   @map("display_name")
  platformAdmin Boolean  @default(false) @map("platform_admin")
  locale        String   @default("fi")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  auditEvents AuditEvent[] @relation("AuditActor")

  @@map("users")
}

model Permission {
  key         String @id
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model ModuleCatalog {
  key              String @id
  version          String
  dependenciesJson Json   @map("dependencies_json")

  entitlements TenantEntitlement[]
  modules      TenantModule[]

  @@map("module_catalog")
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  orgUnitMemberships OrgUnitMembership[]
  membershipRoles    MembershipRole[]
  ownedRisks           Risk[]           @relation("RiskOwner")
  assessments          RiskAssessment[] @relation("AssessmentAssessor")
  submittedTreatments  RiskTreatment[]  @relation("TreatmentSubmitter")
  approvedTreatments   RiskTreatment[]  @relation("TreatmentApprover")
  assignedActions      RiskAction[]     @relation("ActionAssignee")
  approvals            Approval[]       @relation("ApprovalActor")
  invitationsSent      Invitation[]     @relation("InvitationInviter")
  uploadedAttachments  Attachment[]     @relation("AttachmentUploader")
  notifications        Notification[]

  @@unique([tenantId, userId], map: "memberships_tenant_user_key")
  @@unique([tenantId, id], map: "memberships_tenant_id_key")
  @@index([tenantId], map: "memberships_tenant_idx")
  @@map("memberships")
}

model OrgUnit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnitMemberships OrgUnitMembership[]
  risks              Risk[]

  @@unique([tenantId, id], map: "org_units_tenant_id_key")
  @@index([tenantId], map: "org_units_tenant_idx")
  @@map("org_units")
}

model OrgUnitMembership {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  orgUnitId    String   @map("org_unit_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  orgUnit    OrgUnit    @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, orgUnitId], map: "org_unit_memberships_unique")
  @@unique([tenantId, id], map: "org_unit_memberships_tenant_id_key")
  @@index([tenantId], map: "org_unit_memberships_tenant_idx")
  @@map("org_unit_memberships")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  label     String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, key], map: "roles_tenant_key_key")
  @@unique([tenantId, id], map: "roles_tenant_id_key")
  @@index([tenantId], map: "roles_tenant_idx")
  @@map("roles")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([tenantId, roleId, permissionKey])
  @@index([tenantId], map: "role_permissions_tenant_idx")
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  orgUnitId    String?  @map("org_unit_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "membership_roles_tenant_id_key")
  @@index([tenantId], map: "membership_roles_tenant_idx")
  @@map("membership_roles")
}

model RiskCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risks  Risk[]

  @@unique([tenantId, code], map: "risk_categories_tenant_code_key")
  @@unique([tenantId, id], map: "risk_categories_tenant_id_key")
  @@index([tenantId], map: "risk_categories_tenant_idx")
  @@map("risk_categories")
}

model Risk {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  code               String
  title              String
  description        String?
  categoryId         String    @map("category_id") @db.Uuid
  orgUnitId          String    @map("org_unit_id") @db.Uuid
  ownerMembershipId  String    @map("owner_membership_id") @db.Uuid
  status             String    @default("open")
  customValues       Json      @default("{}") @map("custom_values_json")
  formVersionId      String?   @map("form_version_id") @db.Uuid
  version            Int       @default(1)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category RiskCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  orgUnit  OrgUnit  @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  owner       Membership       @relation("RiskOwner", fields: [tenantId, ownerMembershipId], references: [tenantId, id], onDelete: Restrict)
  assessments RiskAssessment[]
  treatment   RiskTreatment?
  actions     RiskAction[]
  formVersion FormVersion?     @relation(fields: [tenantId, formVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, code], map: "risks_tenant_code_key")
  @@unique([tenantId, id], map: "risks_tenant_id_key")
  @@index([tenantId, status], map: "risks_tenant_status_idx")
  @@index([tenantId, createdAt, id], map: "risks_tenant_created_idx")
  @@index([tenantId, orgUnitId], map: "risks_tenant_org_unit_idx")
  @@index([tenantId, ownerMembershipId], map: "risks_tenant_owner_idx")
  @@index([tenantId, categoryId], map: "risks_tenant_category_idx")
  @@map("risks")
}

model ScoringModel {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  key            String
  version        Int
  definitionJson Json      @map("definition_json")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assessments RiskAssessment[]

  @@unique([tenantId, key, version], map: "scoring_models_tenant_key_version_key")
  @@unique([tenantId, id], map: "scoring_models_tenant_id_key")
  @@index([tenantId], map: "scoring_models_tenant_idx")
  @@map("scoring_models")
}

model RiskAssessment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  riskId           String   @map("risk_id") @db.Uuid
  assessmentType   String   @map("assessment_type")
  likelihood       Int
  impact           Int
  score            Int
  rating           String
  scoringVersionId String   @map("scoring_version_id") @db.Uuid
  rationale        String
  assessedBy       String   @map("assessed_by") @db.Uuid
  assessedAt       DateTime @default(now()) @map("assessed_at") @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risk          Risk        @relation(fields: [tenantId, riskId], references: [tenantId, id], onDelete: Restrict)
  scoringModel  ScoringModel @relation(fields: [tenantId, scoringVersionId], references: [tenantId, id], onDelete: Restrict)
  assessor      Membership  @relation("AssessmentAssessor", fields: [tenantId, assessedBy], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "risk_assessments_tenant_id_key")
  @@index([tenantId, riskId, assessedAt], map: "risk_assessments_risk_assessed_idx")
  @@index([tenantId, assessmentType, assessedAt], map: "risk_assessments_type_assessed_idx")
  @@map("risk_assessments")
}

model RiskTreatment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  riskId            String    @map("risk_id") @db.Uuid
  strategy          String
  status            String    @default("pending")
  currentStage      String    @default("treatment") @map("current_stage")
  targetDate        DateTime? @map("target_date") @db.Date
  acceptanceReason  String?   @map("acceptance_reason")
  submittedById     String    @map("submitted_by") @db.Uuid
  approvedById      String?   @map("approved_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risk       Risk       @relation(fields: [tenantId, riskId], references: [tenantId, id], onDelete: Restrict)
  submittedBy Membership @relation("TreatmentSubmitter", fields: [tenantId, submittedById], references: [tenantId, id], onDelete: Restrict)
  approvedBy  Membership? @relation("TreatmentApprover", fields: [tenantId, approvedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, riskId], map: "risk_treatments_tenant_risk_key")
  @@unique([tenantId, id], map: "risk_treatments_tenant_id_key")
  @@index([tenantId], map: "risk_treatments_tenant_idx")
  @@map("risk_treatments")
}

model RiskAction {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  riskId                String    @map("risk_id") @db.Uuid
  title                 String
  description           String?
  assigneeMembershipId  String    @map("assignee_membership_id") @db.Uuid
  dueAt                 DateTime  @map("due_at") @db.Timestamptz(6)
  status                String    @default("open")
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  risk     Risk       @relation(fields: [tenantId, riskId], references: [tenantId, id], onDelete: Restrict)
  assignee Membership @relation("ActionAssignee", fields: [tenantId, assigneeMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "actions_tenant_id_key")
  @@index([tenantId, status, dueAt], map: "actions_tenant_status_due_idx")
  @@map("actions")
}

model Approval {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  entityType           String    @map("entity_type")
  entityId             String    @map("entity_id") @db.Uuid
  stage                String
  approverMembershipId String    @map("approver_membership_id") @db.Uuid
  decision             String
  decidedAt            DateTime  @default(now()) @map("decided_at") @db.Timestamptz(6)
  comment              String

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  approver Membership @relation("ApprovalActor", fields: [tenantId, approverMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "approvals_tenant_id_key")
  @@index([tenantId, entityType, entityId], map: "approvals_entity_idx")
  @@map("approvals")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payloadJson Json      @map("payload_json")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "outbox_events_tenant_id_key")
  @@index([tenantId, processedAt], map: "outbox_events_tenant_processed_idx")
  @@map("outbox_events")
}

model Attachment {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  entityType             String    @map("entity_type")
  entityId               String    @map("entity_id") @db.Uuid
  objectKey              String    @map("object_key")
  filename               String
  mime                   String
  size                   Int
  scanStatus             String    @default("pending") @map("scan_status")
  uploadedAt             DateTime? @map("uploaded_at") @db.Timestamptz(6)
  uploadedByMembershipId String    @map("uploaded_by_membership_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy Membership @relation("AttachmentUploader", fields: [tenantId, uploadedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "attachments_tenant_id_key")
  @@unique([tenantId, objectKey], map: "attachments_tenant_object_key")
  @@index([tenantId, entityType, entityId], map: "attachments_entity_idx")
  @@map("attachments")
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  type         String
  payloadJson  Json      @map("payload_json")
  dedupeKey    String    @map("dedupe_key")
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "notifications_tenant_id_key")
  @@unique([tenantId, membershipId, dedupeKey], map: "notifications_dedupe_key")
  @@index([tenantId, membershipId, createdAt], map: "notifications_inbox_idx")
  @@map("notifications")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  requestId  String?  @map("request_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "audit_events_tenant_id_key")
  @@index([tenantId, occurredAt], map: "audit_events_tenant_occurred_idx")
  @@map("audit_events")
}

model FormDefinition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  name         String
  targetEntity String   @map("target_entity")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions FormVersion[]

  @@unique([tenantId, key], map: "form_definitions_tenant_key_key")
  @@unique([tenantId, id], map: "form_definitions_tenant_id_key")
  @@index([tenantId], map: "form_definitions_tenant_idx")
  @@map("form_definitions")
}

model FormVersion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  version      Int
  schemaJson   Json      @map("schema_json")
  uiJson       Json      @map("ui_json")
  status       String    @default("draft")
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition FormDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)
  risks      Risk[]

  @@unique([tenantId, definitionId, version], map: "form_versions_tenant_definition_version_key")
  @@unique([tenantId, id], map: "form_versions_tenant_id_key")
  @@index([tenantId, definitionId, status], map: "form_versions_tenant_definition_status_idx")
  @@map("form_versions")
}

model TenantEntitlement {
  tenantId  String  @map("tenant_id") @db.Uuid
  moduleKey String  @map("module_key")
  entitled  Boolean @default(true)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module ModuleCatalog @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([tenantId, moduleKey])
  @@index([tenantId], map: "tenant_entitlements_tenant_idx")
  @@map("tenant_entitlements")
}

model TenantModule {
  tenantId     String   @map("tenant_id") @db.Uuid
  moduleKey    String   @map("module_key")
  enabled      Boolean  @default(false)
  settingsJson Json     @default("{}") @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  module ModuleCatalog @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@id([tenantId, moduleKey])
  @@index([tenantId], map: "tenant_modules_tenant_idx")
  @@map("tenant_modules")
}

model Invitation {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  email                 String
  roleKey               String    @map("role_key")
  orgUnitId             String?   @map("org_unit_id") @db.Uuid
  tokenHash             String    @unique @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime? @map("accepted_at") @db.Timestamptz(6)
  invitedByMembershipId String    @map("invited_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy Membership @relation("InvitationInviter", fields: [tenantId, invitedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id], map: "invitations_tenant_id_key")
  @@index([tenantId], map: "invitations_tenant_idx")
  @@map("invitations")
}
