# Local development only. Next.js loads this for every runtime (RSC, route handlers, middleware).
AUTH_SECRET=riskflow_auth_secret_dev_only_min_32_chars
AUTH_URL=http://127.0.0.1:3000
AUTH_ISSUER=http://127.0.0.1:3300
AUTH_CLIENT_ID=riskflow-web
AUTH_CLIENT_SECRET=riskflow_oidc_dev_only
AUTH_TRUST_HOST=true
DATABASE_URL_APP=postgresql://riskflow_app:riskflow_app_dev_only@127.0.0.1:5432/riskflow
