# Local development only. Copy to .env and never commit secrets.
NODE_ENV=development
# development | staging | production. Production rejects *_dev_only secrets.
APP_ENV=development

# Local development credentials for `pnpm services:start`. Do not use in production.
# DATABASE_URL is the migrator/owner role. Runtime uses APP/WORKER roles (no BYPASSRLS).
DATABASE_URL=postgresql://riskflow:riskflow_dev_only@localhost:5432/riskflow
DATABASE_URL_APP=postgresql://riskflow_app:riskflow_app_dev_only@localhost:5432/riskflow
DATABASE_URL_WORKER=postgresql://riskflow_worker:riskflow_worker_dev_only@localhost:5432/riskflow
REDIS_URL=redis://localhost:6379

# Auth.js / OIDC. Local issuer is started by `pnpm services:start` (no Docker).
AUTH_SECRET=riskflow_auth_secret_dev_only_min_32_chars
AUTH_URL=http://127.0.0.1:3000
AUTH_ISSUER=http://127.0.0.1:3300
AUTH_CLIENT_ID=riskflow-web
AUTH_CLIENT_SECRET=riskflow_oidc_dev_only
AUTH_TRUST_HOST=true

# Private object storage. Local disk adapter is the default (no Docker).
OBJECT_STORAGE_DIR=.local/object-storage
OBJECT_SIGNING_SECRET=riskflow_object_signing_secret_dev_only_min_32

# Rate limits (in-process; put a reverse-proxy limit in front of multiple Node instances).
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_MUTATION_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_TRUST_PROXY=false

# Audit retention for the owner-role DBA script (days). App/worker cannot DELETE audit_events.
AUDIT_RETENTION_DAYS=730

# Optional S3-compatible backend (empty = local disk).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
